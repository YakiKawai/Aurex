<!-- Aurex: иконка категории "Платные возможности".

     Цвет путей ДОЛЖЕН быть белым: TextSettingsCell.setIcon накладывает
     PorterDuffColorFilter(key_windowBackgroundWhiteGrayIcon, MULTIPLY), а MULTIPLY даёт
     src * tint. Белый src -> ровно цвет темы (серый), чёрный src -> всегда чёрный.

     Геометрия и толщина обводки — как у msg_aurex_ghost и msg_aurex_spy, чтобы все
     категории в списке выглядели одной семьёй. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="26dp"
    android:height="26dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,3.6 L14.41,8.88 L20.18,9.54 L15.9,13.47 L17.06,19.16 L12,16.3 L6.94,19.16 L8.1,13.47 L3.82,9.54 L9.59,8.88 Z" />
</vector>
